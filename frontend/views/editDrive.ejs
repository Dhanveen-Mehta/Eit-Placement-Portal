<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Placement Drive</title>
    <link rel="stylesheet" href="/newDrive.css">
</head>

<body>

    <h1 id="form-heading">Edit Placement Drive of <%=searchedDrive.companyName%></h1>

    <div id="form-container">

        <form id="drive-form" method="post" action="/admin/<%=searchedDrive._id%>/edit?_method=PUT">

            <input id="company-name" placeholder="Enter Company Name" name="companyName" type="text" required value="<%=searchedDrive.companyName%>">

            <input id="company-location" placeholder="Enter Company Location" name="companyLocation" type="text" required value="<%=searchedDrive.companyLocation%>">

            <input id="ctc-input" placeholder="Enter CTC in Rupees per Year " name="ctc" type="number" required value="<%=searchedDrive.ctc%>">

            <textarea id="job-desc" placeholder="Enter Job Description" name="jobDescription" required><%=searchedDrive.jobDescription%></textarea>

            <input id="cgpa-input" placeholder="Enter Minimum CGPA" name="minimumCgpa" type="number" min="0" max="10" step="0.1" required value="<%=searchedDrive.minimumCgpa%>">

            <button id="submit-btn" type="submit">Edit Drive</button>

        </form>

    </div>

</body>
</html>